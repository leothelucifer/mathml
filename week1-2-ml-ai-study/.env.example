# Copy to .env.local (not committed) to turn on Google sign-in and cloud progress.
# Values come from Firebase console > Project settings > Your apps > Web app. They are not secrets:
# the Firestore rules (firestore.rules) are what protect each student's data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Local testing against the Firebase emulators (npx firebase-tools emulators:start):
# VITE_FIREBASE_EMULATOR=1
